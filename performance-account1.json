      "views": 57,
      "replies": 0,
      "likes": 0,
      "reposts": 0,
      "last_fetched": 1784953485.6459837
    },
    {
      "id": "18357276979208939",
      "text": "unpopular opinion: ceiling fans are the only thing holding this country together.",
